symbols    = ["RoomView", "NewRoomDialog", "TeamHireDialog", "ForumLens", "layoutTeamMap", "drawNames"]
touches    = ["src/components/rooms/RoomView.tsx", "src/components/rooms/NewRoomDialog.tsx", "src/components/rooms/TeamHireDialog.tsx", "src/components/rooms/ForumLens.tsx", "src/components/rooms/TeamMap.tsx", "src/lib/threads.ts", "src/lib/teamMap.ts", "src/lib/teamLibrary.ts", "src/state/reducer.ts"]
